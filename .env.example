# ── Required ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIza...your-key-here

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-string

# ── Admin account (created on first boot) ────────────────────────────────────
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@2025!

# ── CORS (add your domain, comma-separated) ──────────────────────────────────
# The backend allows localhost by default; add your public domain here.
CORS_ORIGINS=https://yourdomain.com

# ── Optional: force-reset admin password on next restart ─────────────────────
# FORCE_RESET_ADMIN=true

# ── MongoDB (leave as-is when using docker-compose) ──────────────────────────
MONGODB_URL=mongodb://mongo:27017
DB_NAME=video_reviewer
